<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension">

  <?define ProductVersion="1.0.0.0" ?>
  <?define ProductName="PricingML Motor" ?>
  <?define Manufacturer="PricingML" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="3082"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="12345678-1234-1234-1234-123456789ABC">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"/>

    <!-- Allow downgrades for development -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."/>

    <!-- Media definition -->
    <Media Id="1" Cabinet="PricingML-Motor.cab" EmbedCab="yes"/>

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="PricingMLFolder" Name="PricingML">
          <Directory Id="INSTALLFOLDER" Name="Motor"/>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="PricingMLProgramMenu" Name="PricingML"/>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <!-- Features -->
    <Feature Id="MotorFeature"
             Title="PricingML Motor"
             Description="PricingML REST API Motor"
             Display="expand"
             Level="1">
      <ComponentRef Id="MotorExecutables"/>
      <ComponentRef Id="MotorConfig"/>
      <ComponentRef Id="MotorService"/>
      <ComponentRef Id="MotorShortcuts"/>
      <ComponentRef Id="MotorRegistry"/>
    </Feature>

    <!-- Components -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Motor executable files -->
      <Component Id="MotorExecutables" Guid="22222222-2222-2222-2222-222222222221">
        <File Id="PricingApiExe"
              Name="PricingApi.exe"
              Source="..\PricingEngine\src\PricingApi\bin\Release\net10.0\publish\PricingApi.exe"
              KeyPath="yes"/>
        <!-- Include all DLLs from publish directory -->
        <File Name="*.dll" Source="..\PricingEngine\src\PricingApi\bin\Release\net10.0\publish\*.dll"/>
        <File Name="appsettings.json" Source="..\PricingEngine\src\PricingApi\bin\Release\net10.0\publish\appsettings.json"/>
      </Component>

      <!-- Configuration file (generated during install) -->
      <Component Id="MotorConfig" Guid="33333333-3333-3333-3333-333333333331">
        <File Id="AppSettingsFile"
              Name="appsettings.json"
              Source="..\PricingEngine\src\PricingApi\bin\Release\net10.0\publish\appsettings.json"
              KeyPath="yes"/>
      </Component>

      <!-- Windows Service registration -->
      <Component Id="MotorService" Guid="44444444-4444-4444-4444-444444444441">
        <util:ServiceInstall Id="MotorServiceInstall"
                             Name="PricingMLMotor"
                             DisplayName="PricingML Motor API"
                             Description="PricingML REST API Service"
                             Type="ownProcess"
                             Start="auto"
                             ErrorControl="normal"
                             Interactive="no"
                             Arguments=""/>
        <util:ServiceControl Id="MotorServiceControl"
                             Name="PricingMLMotor"
                             Start="install"
                             Stop="both"
                             Remove="uninstall"
                             Wait="yes"/>
      </Component>

      <!-- Registry entries -->
      <Component Id="MotorRegistry" Guid="55555555-5555-5555-5555-555555555551">
        <RegistryKey Root="HKLM" Key="SOFTWARE\PricingML\Motor">
          <RegistryValue Type="string" Name="InstallDir" Value="[INSTALLFOLDER]"/>
          <RegistryValue Type="string" Name="Version" Value="$(var.ProductVersion)"/>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!-- Start Menu Shortcuts -->
    <DirectoryRef Id="PricingMLProgramMenu">
      <Component Id="MotorShortcuts" Guid="66666666-6666-6666-6666-666666666661">
        <Shortcut Id="MotorSwaggerShortcut"
                  Name="Abrir Swagger UI"
                  Target="http://localhost:[MOTORPORT]/swagger"
                  Description="Open Motor API Swagger documentation"/>
        <Shortcut Id="MotorUninstallShortcut"
                  Name="Desinstalar Motor"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Uninstall PricingML Motor"/>
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\PricingMLMotor"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Properties (UI variables) -->
    <Property Id="MOTORPORT" Value="5000"/>
    <Property Id="SQLHOSTNAME" Value="localhost"/>
    <Property Id="SQLPORT" Value="1433"/>
    <Property Id="SQLUSER" Value="sa"/>
    <Property Id="SQLPASSWORD" Value=""/>

    <!-- InstallUISequence (User prompts) -->
    <InstallUISequence>
      <Show Dialog="WelcomeDialog" After="LoadDefaults"/>
      <Show Dialog="ConfigurationDialog" After="WelcomeDialog"/>
      <Show Dialog="ProgressDialog" After="ConfigurationDialog"/>
      <Show Dialog="ExitDialog" OnExit="success"/>
    </InstallUISequence>

    <!-- Dialogs -->
    <UI>
      <!-- Welcome Dialog -->
      <Dialog Id="WelcomeDialog" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Text="Welcome to [ProductName]"/>
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="80" Text="This wizard will guide you through the installation of [ProductName]."/>
        <Control Id="NextButton" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="Next"/>
        <Control Id="CancelButton" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel"/>
      </Dialog>

      <!-- Configuration Dialog -->
      <Dialog Id="ConfigurationDialog" Width="370" Height="350" Title="Configuration">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Text="Motor Configuration"/>
        <Control Id="InstallPathLabel" Type="Text" X="20" Y="50" Width="100" Height="12" Text="Installation Path:"/>
        <Control Id="InstallPathEdit" Type="PathEdit" X="20" Y="65" Width="330" Height="18" Property="INSTALLFOLDER"/>

        <Control Id="MotorPortLabel" Type="Text" X="20" Y="90" Width="100" Height="12" Text="Motor Port:"/>
        <Control Id="MotorPortEdit" Type="Edit" X="20" Y="105" Width="100" Height="18" Property="MOTORPORT"/>

        <Control Id="SqlLabel" Type="Text" X="20" Y="130" Width="330" Height="12" Text="SQL Server Configuration:"/>

        <Control Id="SqlHostLabel" Type="Text" X="20" Y="145" Width="100" Height="12" Text="Hostname:"/>
        <Control Id="SqlHostEdit" Type="Edit" X="20" Y="160" Width="150" Height="18" Property="SQLHOSTNAME"/>

        <Control Id="SqlPortLabel" Type="Text" X="180" Y="145" Width="50" Height="12" Text="Port:"/>
        <Control Id="SqlPortEdit" Type="Edit" X="180" Y="160" Width="100" Height="18" Property="SQLPORT"/>

        <Control Id="SqlUserLabel" Type="Text" X="20" Y="185" Width="100" Height="12" Text="Username:"/>
        <Control Id="SqlUserEdit" Type="Edit" X="20" Y="200" Width="150" Height="18" Property="SQLUSER"/>

        <Control Id="SqlPassLabel" Type="Text" X="180" Y="185" Width="100" Height="12" Text="Password:"/>
        <Control Id="SqlPassEdit" Type="Edit" X="180" Y="200" Width="150" Height="18" Property="SQLPASSWORD" Password="yes"/>

        <Control Id="BackButton" Type="PushButton" X="170" Y="325" Width="56" Height="17" Text="Back"/>
        <Control Id="NextButton" Type="PushButton" X="236" Y="325" Width="56" Height="17" Text="Next"/>
        <Control Id="CancelButton" Type="PushButton" X="304" Y="325" Width="56" Height="17" Text="Cancel"/>
      </Dialog>

      <!-- Progress Dialog -->
      <Dialog Id="ProgressDialog" Width="370" Height="270" Title="Installing [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Text="Installing [ProductName]"/>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="100" Width="330" Height="10"/>
        <Control Id="StatusText" Type="Text" X="20" Y="120" Width="330" Height="40" Text="Please wait while [ProductName] is being installed..."/>
      </Dialog>

      <!-- Exit Dialog -->
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="Completed">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Text="[ProductName] Installation Complete"/>
        <Control Id="Message" Type="Text" X="20" Y="50" Width="330" Height="80" Text="[ProductName] has been successfully installed.&#10;&#10;To start the Motor service:&#10;1. Open Windows Services (services.msc)&#10;2. Find 'PricingML Motor API'&#10;3. Right-click and select 'Start'&#10;&#10;Access Swagger UI at: http://localhost:[MOTORPORT]/swagger"/>
        <Control Id="FinishButton" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Finish"/>
      </Dialog>
    </UI>

    <!-- .NET Framework prerequisite -->
    <PropertyRef Id="NETFRAMEWORK45" />
  </Product>
</Wix>
