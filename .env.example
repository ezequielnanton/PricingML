# ============================================================================
# CONFIGURACIÓN DE PRICINGML - Copia este archivo a .env y reemplaza los valores
# ============================================================================

# SQL Server Configuration
# Si usas SQL Server local/existente, desactiva el servicio sqlserver en docker-compose
# y actualiza CONNECTION_STRING con tu servidor local
SQL_SA_PASSWORD=YourSQLServerPassword123!
CONNECTION_STRING=Server=sqlserver;Database=PRICES_DB;User Id=sa;Password=YourSQLServerPassword123!;TrustServerCertificate=True;

# Frontend API Base URL
# Reemplaza con la IP/hostname de tu servidor si no es localhost
API_BASE_URL=http://localhost:5000

# Mercado Libre Integration (opcional)
ML_API_BASE_URL=https://api.mercadolibre.com
ML_CLIENT_ID=your-client-id-here
ML_CLIENT_SECRET=your-client-secret-here

# SQL Initialization Script (opcional)
# Ruta al script SQL que se ejecuta en el inicio de SQL Server
SQL_INIT_SCRIPT=./PricingEngine/SQL/init.sql
